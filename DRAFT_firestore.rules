rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Articles Rules
    match /articles/{articleId} {
      allow read: if true; // Publicly readable for website
      allow write: if isSignedIn(); // Restricted to staff
      
      function isValidArticle(data) {
        return data.uuid is string && data.title is string && data.slug is string;
      }

      allow create: if isSignedIn() && isValidArticle(incoming());
      allow update: if isSignedIn() && isValidArticle(incoming());
      allow delete: if isSignedIn();
    }

    // Products Rules
    match /products/{productId} {
      allow read: if true; // Publicly readable for catalogue
      allow write: if isSignedIn();
      
      function isValidProduct(data) {
        return data.name is string && data.sku is string && data.price is number;
      }

      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidProduct(incoming());
      allow delete: if isSignedIn();
    }

    // Transactions Rules
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      function isValidTransaction(data) {
        return data.uuid is string && data.total is number && data.status in ['COMPLETED', 'PENDING', 'CANCELLED'];
      }

      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidTransaction(incoming());
    }

    // Settings Rules
    match /settings/{settingId} {
      allow read: if true; // Some settings like company identity are public
      allow write: if isSignedIn();
      
      function isValidSetting(data) {
        return data.key is string && data.value is map;
      }

      allow create: if isSignedIn() && isValidSetting(incoming());
      allow update: if isSignedIn() && isValidSetting(incoming());
    }
  }
}
